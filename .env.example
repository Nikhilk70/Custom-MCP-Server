# AUTO-JOB-AGENT — environment template. Copy to .env and fill in. Never commit .env.

# ---------- Google Sheets (REQUIRED — the only database; the jobs tab is also your dashboard) ----------
GOOGLE_SHEETS_SPREADSHEET_ID=
# Service-account key JSON (share the sheet with its client_email) OR an OAuth "Desktop app" client JSON
GOOGLE_SHEETS_CREDENTIALS_PATH=./config/google-credentials.json
# Only for OAuth clients; created by `npm run sheets:auth`
GOOGLE_SHEETS_TOKEN_PATH=./config/google-token.json
# Optional: tab holding the jobs table (default: first non-system tab)
GOOGLE_SHEETS_TAB=

# ---------- AI provider (optional; only used for fact-checked summary rephrasing) ----------
AI_PROVIDER=gemini          # gemini | none   (openai/anthropic adapters not implemented)
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- Overleaf (compile) — no Overleaf MCP configured yet ----------
OVERLEAF_SESSION=
OVERLEAF_GIT_TOKEN=
OVERLEAF_PROJECT_ID=
# Local pdfLaTeX fallback (MiKTeX / TeX Live). Leave empty to auto-detect latexmk/pdflatex on PATH.
LOCAL_LATEX_COMMAND=

# ---------- Firecrawl (REST v1; read/extract only) ----------
FIRECRAWL_API_KEY=
# Optional: a GitHub token (no scopes needed) so evidence checks aren't limited to 60 GitHub requests/hour.
GITHUB_TOKEN=

# ---------- Browser ----------
PLAYWRIGHT_HEADLESS=false
# Persistent profile where YOU log in once (default runtime/browser-profile). The agent's own profile, never your everyday Chrome profile.
BROWSER_PROFILE_DIR=
# chrome = your installed Google Chrome (needed for "Sign in with Google"); empty = Playwright's bundled Chromium
BROWSER_CHANNEL=chrome
# Account to pick in Google's account chooser for "Sign in with Google" (empty = MY_DATA personal.email). No password, ever:
# sign in to Google once yourself with `npm run browser:login`.
GOOGLE_SIGNIN_ACCOUNT=

# ---------- LinkedIn ----------
# Not used: the agent never logs in with a password or replays cookies. Integrate a LinkedIn MCP instead.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
LINKEDIN_LI_AT=
LINKEDIN_AUTH_STATE_PATH=./runtime/state/linkedin-auth-state.json

# ---------- Application engine ----------
APPLICATION_MODE=REVIEW_ONLY   # REVIEW_ONLY | AUTO_FILL_REVIEW_SUBMIT | FULL_AUTO
DRY_RUN=true                   # true = never submit

# ---------- Job search ----------
JOB_KEYWORDS=
JOB_LOCATIONS=
JOB_EXPERIENCE_LEVEL=
JOB_DATE_SINCE_POSTED=
JOB_LIMIT=50
MINIMUM_MATCH_SCORE=60

# ---------- Portals (reported UNSUPPORTED until an adapter/MCP exists) ----------
PORTAL_NAUKRI_ENABLED=false
PORTAL_INDEED_ENABLED=false
PORTAL_INTERNSHALA_ENABLED=false
PORTAL_GLASSDOOR_ENABLED=false
PORTAL_UNSTOP_ENABLED=false
PORTAL_SHINE_ENABLED=false
PORTAL_TIMESJOBS_ENABLED=false

# ---------- Scheduler ----------
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_DAILY_TIME=09:00

# ---------- Logging ----------
LOG_LEVEL=info
LOG_DIR=./Applications/Logs
